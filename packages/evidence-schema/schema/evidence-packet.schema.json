{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nexteleven.dev/evidencelens/schema/evidence-packet-0.1.0.json",
  "title": "EvidenceLens Evidence Packet",
  "type": "object",
  "additionalProperties": false,
  "required": ["packetId", "schemaVersion", "claim", "sources", "evidenceSpans", "deterministicAssertions", "reviewContext", "provenance"],
  "properties": {
    "packetId": {"type": "string", "minLength": 1},
    "schemaVersion": {"const": "0.1.0"},
    "claim": {"$ref": "#/$defs/claim"},
    "sources": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/source"}},
    "evidenceSpans": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/span"}},
    "deterministicAssertions": {"type": "array", "items": {"$ref": "#/$defs/assertion"}},
    "reviewContext": {
      "type": "object",
      "additionalProperties": false,
      "required": ["domain", "intendedUse", "requestedChecks"],
      "properties": {
        "domain": {"type": "string", "minLength": 1},
        "intendedUse": {"const": "RESEARCH_TRIAGE"},
        "requestedChecks": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["createdBy", "createdAt", "creationActivityId", "softwareVersion"],
      "properties": {
        "createdBy": {"type": "string", "minLength": 1},
        "createdAt": {"type": "string", "format": "date-time"},
        "creationActivityId": {"type": "string", "minLength": 1},
        "softwareVersion": {"type": "string", "minLength": 1}
      }
    }
  },
  "$defs": {
    "epistemicClass": {"enum": ["OBSERVED", "INFERRED", "GENERATED"]},
    "hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "location": {
      "type": "object",
      "minProperties": 1,
      "properties": {
        "artifactId": {"type": "string"},
        "section": {"type": "string"},
        "page": {"type": "integer", "minimum": 1},
        "paragraph": {"type": "integer", "minimum": 1},
        "table": {"type": "string"},
        "cell": {"type": "string"},
        "figure": {"type": "string"},
        "fieldPath": {"type": "string"},
        "startOffset": {"type": "integer", "minimum": 0},
        "endOffset": {"type": "integer", "minimum": 0}
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claimId", "verbatim", "contextType", "epistemicClass"],
      "properties": {
        "claimId": {"type": "string", "minLength": 1},
        "verbatim": {"type": "string", "minLength": 1},
        "contextType": {"type": "string", "minLength": 1},
        "location": {"$ref": "#/$defs/location"},
        "claimType": {"enum": ["CAUSAL", "ASSOCIATIONAL", "COMPARATIVE", "QUANTITATIVE_EFFECT", "PREVALENCE", "SAFETY", "MECHANISM", "GENERALIZATION", "REPLICATION", "NO_EFFECT", "METHODOLOGICAL", "UNKNOWN"]},
        "normalizedText": {"type": "string"},
        "normalizationConfirmed": {"type": "boolean"},
        "epistemicClass": {"$ref": "#/$defs/epistemicClass"}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceId", "sourceType", "identifiers", "version", "retrievedAt", "status", "statusCheckedAt", "metadataHash", "retentionAuthority"],
      "properties": {
        "sourceId": {"type": "string", "minLength": 1},
        "sourceType": {"type": "string", "minLength": 1},
        "identifiers": {
          "type": "object",
          "minProperties": 1,
          "properties": {
            "doi": {"type": "string"},
            "pmid": {"type": "string"},
            "pmcid": {"type": "string"},
            "nct": {"type": "string"},
            "dataciteDoi": {"type": "string"},
            "url": {"type": "string", "format": "uri"}
          }
        },
        "version": {"type": "string", "minLength": 1},
        "retrievedAt": {"type": "string", "format": "date-time"},
        "status": {"enum": ["CURRENT", "CORRECTED", "RETRACTED", "WITHDRAWN", "EXPRESSION_OF_CONCERN", "UNKNOWN"]},
        "statusCheckedAt": {"type": "string", "format": "date-time"},
        "contentHash": {"$ref": "#/$defs/hash"},
        "metadataHash": {"$ref": "#/$defs/hash"},
        "license": {"type": "string"},
        "retentionAuthority": {"enum": ["PUBLIC_METADATA", "OPEN_LICENSE", "USER_AUTHORIZED", "PROJECT_AUTHORED"]}
      }
    },
    "span": {
      "type": "object",
      "additionalProperties": false,
      "required": ["spanId", "sourceId", "locator", "verbatim", "contentHash", "extractionMethod", "verifiedAgainstSource", "epistemicClass"],
      "properties": {
        "spanId": {"type": "string", "minLength": 1},
        "sourceId": {"type": "string", "minLength": 1},
        "locator": {"$ref": "#/$defs/location"},
        "verbatim": {"type": "string", "minLength": 1},
        "contentHash": {"$ref": "#/$defs/hash"},
        "extractionMethod": {"enum": ["USER_SELECTED", "STRUCTURED_FIELD", "MODEL_PROPOSED", "PARSER_EXTRACTED"]},
        "extractorVersion": {"type": "string"},
        "verifiedAgainstSource": {"const": true},
        "epistemicClass": {"const": "OBSERVED"}
      }
    },
    "assertion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assertionId", "assertionType", "value", "inputRefs", "checker", "checkerVersion", "checkedAt", "epistemicClass"],
      "properties": {
        "assertionId": {"type": "string", "minLength": 1},
        "assertionType": {"type": "string", "minLength": 1},
        "value": {
          "anyOf": [
            {"type": "string"},
            {"type": "number"},
            {"type": "boolean"},
            {"type": "null"}
          ]
        },
        "inputRefs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "checker": {"type": "string", "minLength": 1},
        "checkerVersion": {"type": "string", "minLength": 1},
        "checkedAt": {"type": "string", "format": "date-time"},
        "epistemicClass": {"const": "OBSERVED"}
      }
    }
  }
}
